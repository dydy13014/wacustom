# ================================== #
# Addon Customization                #
# ================================== #
ADDON_ID=community.wastream # (Optional) Stremio addon identifier (default: community.wastream)
ADDON_NAME="WAStream" # (Optional) Display name in Stremio (default: WAStream)

# ================================== #
# Server Configuration               #
# ================================== #
PORT=7000 # (Optional) HTTP server port (default: 7000)

# ================================== #
# Source Configuration               #
# ================================== #
WAWACITY_URL=https://example.com # (Optional) Wawacity base URL
FREE_TELECHARGER_URL=https://example.com # (Optional) Free-Telecharger base URL
DARKI_API_URL=https://api.example.com # (Optional) Darki-API base URL
DARKI_API_KEY=your_api_key_here # (Optional) Optional API key for Darki-API
MOVIX_URL=https://example.com # (Optional) Movix base URL (API URL auto-generated as api.{domain})
WEBSHARE_URL=https://example.com # (Optional) Webshare base URL
ZONE_TELECHARGEMENT_URL=https://zone-telechargement.org # (Optional) Zone-Telechargement base URL -- attention : plusieurs sites homonymes coexistent avec des moteurs differents, le scraper cible celui du canal Telegram officiel (.org), pas le .estate

# ================================== #
# Kitsu/Anime Configuration          #
# ================================== #
DARKIMOVIX_KITSU_TMDB_MAPPING=["tt0388629"] # (Optional) Default if unset: [] (nothing). Value shown is the recommended one (also 1-click via the admin Settings tab). JSON list of IMDB IDs to use TMDB mapping for Kitsu anime on Darki-API/Movix
KITSU_IMDB_OVERRIDE=["6589=1,8174=2,13893=3,42213=4-1,42927=4-2:tt2250192"] # (Optional) Default if unset: [] (nothing). Value shown is the recommended one (also 1-click via the admin Settings tab). JSON list of custom Kitsu ID to season/episode mapping for specific IMDB

# ================================== #
# Pagination Configuration           #
# ================================== #
WAWACITY_MAX_SEARCH_PAGES=3 # (Optional) Max search result pages (default: 3 pages)
FREE_TELECHARGER_MAX_SEARCH_PAGES=3 # (Optional) Max search result pages for Free-Telecharger (default: 3 pages)
WEBSHARE_MAX_SEARCH_PAGES=3 # (Optional) Max search result pages for Webshare (default: 3 pages)
ZONE_TELECHARGEMENT_MAX_SEARCH_PAGES=3 # (Optional) Max search result pages for Zone-Telechargement (default: 3 pages)
ZONE_TELECHARGEMENT_MAX_CONCURRENCY=16 # (Optional) Max simultaneous zoneurs link resolutions (default: 16)
DARKI_API_MAX_LINK_PAGES=5 # (Optional) Max link pages to fetch (default: 5 pages)
DARKIBOX_LINK_TIMEOUT=2 # (Optional) Soft timeout in seconds for Darkibox links (default: 2s)

# ================================== #
# Database Configuration             #
# ================================== #
DATABASE_TYPE=sqlite # (Optional) Database type: "sqlite" or "postgresql" (default: sqlite)
DATABASE_PATH=/app/data/wastream.db # (Optional) SQLite file path (default: /app/data/wastream.db)
DATABASE_URL=username:password@hostname:port/database # (Required if postgresql) PostgreSQL connection string
DATABASE_BUSY_TIMEOUT_SECONDS=30 # (Optional) SQLite busy timeout in seconds (default: 30)
DATABASE_RETRY_MAX_ATTEMPTS=8 # (Optional) Database attempts including the first try (default: 8)
DATABASE_RETRY_DELAY_SECONDS=0.25 # (Optional) Initial database retry delay in seconds (default: 0.25)

# ================================== #
# Cache Configuration                #
# ================================== #
CONTENT_CACHE_TTL=3600 # (Optional) Content cache duration: -1 = permanent (never expires), or seconds (default: 3600 = 1 hour)
CONTENT_CACHE_MODE=background # (Optional) Cache mode: "background" (wait if expired) or "live" (instant + background refresh) (default: background)
DEAD_LINK_TTL=-1 # (Optional) Dead link cache duration: -1 = permanent (default), or seconds (e.g., 2592000 = 30 days)

# ================================== #
# Lock Configuration                 #
# ================================== #
SCRAPE_LOCK_TTL=300 # (Optional) Lock expiration time in seconds (default: 300 = 5 min)
SCRAPE_WAIT_TIMEOUT=30 # (Optional) Max wait time for lock in seconds (default: 30s)

# ================================== #
# HTTP Timeout Configuration         #
# ================================== #
HTTP_TIMEOUT=15 # (Optional) General HTTP request timeout in seconds (default: 15)
METADATA_TIMEOUT=10 # (Optional) TMDB/Kitsu API timeout in seconds (default: 10)
HEALTH_CHECK_TIMEOUT=5 # (Optional) Health endpoint timeout in seconds (default: 5)

# ================================== #
# Debrid Services Configuration      #
# ================================== #
DEBRID_MAX_RETRIES=5 # (Optional) Max retry attempts for debrid operations (default: 5)
DEBRID_RETRY_DELAY_SECONDS=4 # (Optional) Delay between retries in seconds (default: 4)
STREAM_REQUEST_TIMEOUT=20 # (Optional) Timeout for stream requests in seconds (default: 20)
DEBRID_CACHE_CHECK_HTTP_TIMEOUT=3 # (Optional) Cache check timeout in seconds (default: 3)
DEBRID_HTTP_ERROR_MAX_RETRIES=5 # (Optional) Max retries for HTTP errors (429, 500, 502, 503, 504) (default: 5)
DEBRID_HTTP_ERROR_RETRY_DELAY=1 # (Optional) Delay for HTTP error retries in seconds (default: 1)

# ================================== #
# Resilient Playback Configuration   #
# ================================== #
RESILIENT_MAX_FALLBACKS=10 # (Optional) Hard cap on backup links tried per playback (user value clamped to this) (default: 10)
RESILIENT_MAX_CONCURRENCY=4 # (Optional) Internal safety cap on simultaneous debrid calls in parallel/race mode (default: 4)
RESILIENT_ATTEMPT_TIMEOUT_MAX=60 # (Optional) Hard cap in seconds on the user's per-link wait setting (default: 60)
RESILIENT_TOKEN_MAX_BYTES=3500 # (Optional) Skip embedding backups when the playback token would exceed this size (default: 3500)

# ================================== #
# Proxy Configuration                #
# ================================== #
PROXY_URL=http://warp:1080 # (Optional) Optional HTTP proxy URL - Leave empty if not used

# ================================== #
# Security Configuration             #
# ================================== #
SECRET_KEY=your-secret-key-here # (Required) Encryption key for user configs (min 32 chars) - Generate with: openssl rand -hex 32
ADDON_PASSWORD="password1,password2" # (Optional) Optional password protection - Multiple passwords separated by commas

# ================================== #
# Admin Configuration                #
# ================================== #
ADMIN_PASSWORD=your-admin-password-here # (Optional) Password for admin dashboard - Leave empty to disable admin

# ================================== #
# Logging Configuration              #
# ================================== #
LOG_LEVEL=DEBUG # (Optional) Log level: DEBUG (everything), INFO (workflow + warnings + errors), WARNING (warnings + errors), ERROR (errors only) (default: DEBUG)

# ================================== #
# HTTP Cache Configuration           #
# ================================== #
HTTP_CACHE_ENABLED=false # (Optional) Enable ETag + Cache-Control on API responses (default: false)
HTTP_CACHE_STREAMS_TTL=300 # (Optional) Stream results cache in seconds (default: 300 = 5 min)
HTTP_CACHE_MANIFEST_TTL=86400 # (Optional) Manifest cache in seconds (default: 86400 = 1 day)
HTTP_CACHE_CONFIGURE_TTL=86400 # (Optional) Configure page cache in seconds (default: 86400 = 1 day)
HTTP_CACHE_STALE_WHILE_REVALIDATE=60 # (Optional) Stale-while-revalidate in seconds (default: 60)

# ================================== #
# Health Check Configuration         #
# ================================== #
HEALTH_CHECK_INTERVAL=60 # (Optional) Health check interval in seconds (default: 60 = 1 minute)

# ================================== #
# Domain Synchronization             #
# ================================== #
DOMAIN_SYNC_ENABLED=false # (Optional) Update source domains from their configured Telegram channels (default: false)
DOMAIN_SYNC_INTERVAL=7200 # (Optional) Full Telegram domain sync interval in seconds (default: 7200 = 2 hours)
DOMAIN_SYNC_RECHECK_ON_HEALTH_ERROR=true # (Optional) Recheck a source domain after its health-check reports an error (default: true)
DOMAIN_SYNC_HEALTH_ERROR_RECHECK_DELAY_SECONDS=900 # (Optional) Minimum delay between health-triggered rechecks for one source (default: 900 = 15 minutes)
DOMAIN_SYNC_WAWACITY_TELEGRAM_URL=https://t.me/your_wawacity_channel # (Optional) Official Wawacity Telegram channel URL
DOMAIN_SYNC_FREE_TELECHARGER_TELEGRAM_URL=https://t.me/your_free_telecharger_channel # (Optional) Official Free-Telecharger Telegram channel URL
DOMAIN_SYNC_MOVIX_TELEGRAM_URL=https://t.me/your_movix_channel # (Optional) Official Movix Telegram channel URL
DOMAIN_SYNC_ZONE_TELECHARGEMENT_TELEGRAM_URL=https://t.me/your_zone_telechargement_channel # (Optional) Official Zone-Telechargement Telegram channel URL

# ================================== #
# TMDB Configuration                 #
# ================================== #
TMDB_API_KEY=your_tmdb_api_key_here # (Optional) TMDB API key for auto-filling metadata in WASource (get from https://www.themoviedb.org/settings/api)

# ================================== #
# Pastebin Scraper Configuration      #
# ================================== #
PASTEBIN_SCRAPER_URLS=["https://example.example.com/raw/abc123"] # (Optional) JSON list of pastebin URLs to scrape into WASource (AllDebrid links only)
PASTEBIN_SCRAPER_INTERVAL=86400 # (Optional) Scrape interval in seconds (default: 86400 = 24 hours)
PASTEBIN_SCRAPER_MAX_DEPTH=5 # (Optional) Max recursion depth when a page has only codes and its links are followed to reach content pages (default: 5)
PASTEBIN_SCRAPER_MAX_PAGES=1000 # (Optional) Max pages fetched per starting URL when following index pages (default: 1000, logged if reached)

# ================================== #
# Idrix Scraper Configuration         #
# ================================== #
IDRIX_SCRAPER_URLS=[] # (Optional) JSON list of Rentry/Textup/Idrix PrivateBin URLs; keep the #key fragment for PrivateBin
IDRIX_SCRAPER_INTERVAL=86400 # (Optional) Scrape interval in seconds (default: 86400 = 24 hours)
IDRIX_SCRAPER_MAX_DEPTH=5 # (Optional) Max discovery depth for linked catalog pages (default: 5)
IDRIX_SCRAPER_MAX_PAGES=1000 # (Optional) Max pages fetched per starting URL (default: 1000, logged if reached)
IDRIX_SCRAPER_RETRY_MAX_ATTEMPTS=3 # (Optional) Max attempts for transient Idrix page errors such as HTTP 429/5xx (default: 3)
IDRIX_SCRAPER_RETRY_DELAY_SECONDS=2 # (Optional) Base delay between Idrix retries in seconds (default: 2; Retry-After is respected)
IDRIX_SCRAPER_REQUEST_DELAY_SECONDS=0.15 # (Optional) Minimum delay between Idrix requests to the same host in seconds (default: 0.15)
IDRIX_SCRAPER_MAX_RETRY_DELAY_SECONDS=30 # (Optional) Maximum delay for one retry; longer Retry-After values block that host for the current run (default: 30)

# ================================== #
# Interface Customization            #
# ================================== #
CUSTOM_HTML="Hosted by WAStream" # (Optional) Custom HTML for web interface

# ================================== #
# Sources supplémentaires (Wacustom) #
# ================================== #
# Absentes d'upstream : trackers Torznab/UNIT3D, index DMM et tracker anime,
# interrogés via le débrideur (torrents) plutôt qu'en DDL.

# Trackers Torznab (torrents via débrideur)
YGGREBORN_URL=https://www.yggreborn.org/api
YGGREBORN_API_KEY=
TR4KER_URL=https://tr4ker.net/api
TR4KER_API_KEY=
TORR9_URL=https://api.torr9.net/api/v1/torznab
TORR9_API_KEY=
C411_URL=https://c411.org/api
C411_API_KEY=

# V3X (Torznab ; l'URL du site suffit, l'API est deduite automatiquement)
V3X_URL=https://v3x.club
V3X_API_KEY=

# Trackers UNIT3D (API JSON native, pas Torznab)
GEMINI_URL=
GEMINI_API_KEY=
GENERATIONFREE_URL=
GENERATIONFREE_API_KEY=

# Zilean (index DMM public, pas de clé requise)
ZILEAN_URL=

# Lumio (mylumio.tv) : ne remonte que des torrents deja verifies en cache,
# donc lisibles immediatement. Vide = source desactivee.
# L'identifiant se lit dans l'URL de votre manifest Lumio.
LUMIO_MANIFEST_ID=

# Nyaa (anime, flux RSS public, pas de clé requise)
NYAA_URL=https://nyaa.si
